generator ftsClient {
  provider = "prisma-client-js"
  output   = "../../src/generated/fts-client"
}

datasource ftsDb {
  provider = "mysql"
}

model E_OFFICE_STATS {
  id                     Int       @id @default(autoincrement())
  date                   DateTime  @ftsDb.Date
  department_title       String    @ftsDb.VarChar(255)
  department_id          Int
  total_files            Int       @default(0)
  total_files_open       Int       @default(0)
  total_files_closed     Int       @default(0)
  total_pending_files    Int       @default(0)
  total_normal_files     Int       @default(0)
  total_urgent_files     Int       @default(0)
  total_immediate_files  Int       @default(0)
  avg_turnaround_time    Float     @default(0) @ftsDb.Float
  avg_file_response_time Float     @default(0) @ftsDb.Float
  created_at             DateTime? @ftsDb.DateTime(0)
  updated_at             DateTime? @ftsDb.DateTime(0)
  deleted_at             DateTime? @ftsDb.DateTime(0)
}

model CMS_STATS {
  id                             Int       @id @default(autoincrement())
  date                           DateTime  @ftsDb.Date
  admitTerm                      Int?      @map("Admit Term")
  Student_Intake                 String?   @ftsDb.VarChar(50)
  Regiion                        String?   @ftsDb.VarChar(50)
  Institution                    String?   @ftsDb.VarChar(50)
  acadCareer                     String?   @map("Acad Career") @ftsDb.VarChar(50)
  acadProg                       Int?      @map("Acad Prog")
  programTitle                   String?   @map("Program Title") @ftsDb.VarChar(50)
  Mode                           String?   @ftsDb.VarChar(50)
  Total_Enroll                   Int?
  Total_Enroll_Male              Int?
  Total_Enroll_Female            Int?
  Total_Enroll_Transgender       Int?
  Discontinue_Enroll             Int?
  Discontinue_Enroll_Male        Int?
  Discontinue_Enroll_Female      Int?
  Discontinue_Enrll_Transgender  Int?
  Active_Enroll                  Int?
  Active_Enroll_Male             Int?
  Active_Enroll_Female           Int?
  Active_Enroll_Transgender      Int?
  Bachlor_Enrollment             Int?
  Bachlor_Enrollment_Male        Int?
  Bachlor_Enrollment_Female      Int?
  Bachlor_Enrollment_Transgender Int?
  created_at                     DateTime?
  updated_at                     DateTime?
  deleted_at                     DateTime?

  @@index([Regiion])
  @@index([acadCareer])
  @@index([programTitle])
  @@index([Mode])
  @@index([Student_Intake])
  @@index([Total_Enroll])
}

